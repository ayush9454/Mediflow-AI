#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -x "$repo_root/.tooling/flutter-sdk/bin/flutter" ]]; then
  flutter_command="$repo_root/.tooling/flutter-sdk/bin/flutter"
else
  flutter_command="$(command -v flutter)"
fi
if [[ -d "$repo_root/.tooling/pub-cache" ]]; then
  export PUB_CACHE="$repo_root/.tooling/pub-cache"
fi
export FLUTTER_SUPPRESS_ANALYTICS=true
exec "$flutter_command" --no-version-check --suppress-analytics "$@"
