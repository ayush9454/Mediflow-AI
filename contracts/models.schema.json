    "DoctorSummary": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "department": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Department",
          "type": "string"
        },
        "displayName": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Displayname",
          "type": "string"
        },
        "doctorId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Doctorid",
          "type": "string"
        }
      },
      "required": [
        "doctorId",
        "displayName",
        "department",
        "active"
      ],
      "title": "DoctorSummary",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "unauthenticated",
        "permission_denied",
        "not_found",
        "invalid_request",
        "invalid_upload",
        "expired",
        "quota_exhausted",
        "conflict",
        "temporarily_unavailable",
        "integration_not_configured",
        "not_implemented",
        "internal_error",
        "provider_invalid_response",
        "processing_limit_exceeded"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ErrorField"
          },
          "title": "Fields",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "requestId": {
          "title": "Requestid",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "requestId"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ErrorField": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "field",
        "code"
      ],
      "title": "ErrorField",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        },
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "extractionMethod": {
          "$ref": "#/$defs/ExtractionMethod"
        },
        "page": {
          "maximum": 10,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quotation": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Quotation",
          "type": "string"
        }
      },
      "required": [
        "page",
        "quotation",
        "extractionMethod"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "ExtractionConfiguration": {
      "additionalProperties": false,
      "properties": {
        "evidenceNormalization": {
          "const": "unicode_whitespace_only_v1",
          "default": "unicode_whitespace_only_v1",
          "title": "Evidencenormalization",
          "type": "string"
        },
        "maxInputCharacters": {
          "default": 60000,
          "exclusiveMinimum": 0,
          "maximum": 60000,
          "title": "Maxinputcharacters",
          "type": "integer"
        },
        "maxOutputTokens": {
          "exclusiveMinimum": 0,
          "maximum": 8192,
          "title": "Maxoutputtokens",
          "type": "integer"
        },
        "promptSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Promptsha256",
          "type": "string"
        },
        "schemaSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Schemasha256",
          "type": "string"
        },
        "temperature": {
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "thinkingLevel": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Thinkinglevel",
          "type": "string"
        },
        "version": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "promptSha256",
        "schemaSha256",
        "maxOutputTokens",
        "temperature",
        "thinkingLevel"
      ],
      "title": "ExtractionConfiguration",
      "type": "object"
    },
    "ExtractionMethod": {
      "enum": [
        "native",
        "ocr"
      ],
      "title": "ExtractionMethod",
      "type": "string"
    },
    "HealthResponse": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "service": {
          "const": "mediflow-api",
          "default": "mediflow-api",
          "title": "Service",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "not_ready"
          ],
          "title": "Status",
          "type": "string"
        },
        "syntheticDataOnly": {
          "const": true,
          "default": true,
          "title": "Syntheticdataonly",
          "type": "boolean"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "status",
        "version"
      ],
      "title": "HealthResponse",
      "type": "object"
    },
