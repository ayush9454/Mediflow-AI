{
  "$defs": {
    "Account": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "displayName": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Displayname",
          "type": "string"
        },
        "hospitalId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Hospitalid",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "uid": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Uid",
          "type": "string"
        }
      },
      "required": [
        "uid",
        "hospitalId",
        "displayName",
        "role",
        "active"
      ],
      "title": "Account",
      "type": "object"
    },
    "AnalysisCandidate": {
      "additionalProperties": false,
      "properties": {
        "analysisId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Analysisid",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "jobId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Jobid",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/AnalysisProvenance"
        },
        "providerOutput": {
          "anyOf": [
            {
              "maxLength": 200000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provideroutput"
        },
        "reportId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Reportid",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/LaboratoryRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "sourcePages": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourcePage"
          },
          "title": "Sourcepages",
          "type": "array"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 5000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "analysisId",
        "reportId",
        "jobId",
        "version",
        "rows",
        "provenance",
        "createdAt"
      ],
      "title": "AnalysisCandidate",
      "type": "object"
    },
    "AnalysisProvenance": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractionConfiguration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modelName": {
          "anyOf": [
            {
              "maxLength": 5000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modelname"
        },
        "modelProvider": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Modelprovider",
          "type": "string"
        },
        "modelVersion": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Modelversion",
          "type": "string"
        },
        "pageProcessingPeakRssBytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pageprocessingpeakrssbytes"
        },
        "pageProcessingSeconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pageprocessingseconds"
        },
        "pipelineVersion": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Pipelineversion",
          "type": "string"
        },
        "promptVersion": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Promptversion",
          "type": "string"
        },
        "sourceSha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcesha256"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "pipelineVersion",
        "promptVersion",
        "modelProvider",
        "modelVersion"
      ],
      "title": "AnalysisProvenance",
      "type": "object"
    },
    "ApprovedResult": {
      "additionalProperties": false,
      "properties": {
        "analysisId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Analysisid",
          "type": "string"
        },
        "analysisVersion": {
          "minimum": 1,
          "title": "Analysisversion",
          "type": "integer"
        },
        "correctedRowIds": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Correctedrowids",
          "type": "array"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reportId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Reportid",
          "type": "string"
        },
        "reviewId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Reviewid",
          "type": "string"
        },
        "reviewedAt": {
          "format": "date-time",
          "title": "Reviewedat",
          "type": "string"
        },
        "reviewerId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Reviewerid",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/LaboratoryRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 5000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "unresolvedAcknowledgements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnresolvedAcknowledgement"
          },
          "title": "Unresolvedacknowledgements",
          "type": "array"
        }
      },
      "required": [
        "reportId",
        "analysisId",
        "analysisVersion",
        "reviewId",
        "reviewerId",
        "reviewedAt",
        "rows"
      ],
      "title": "ApprovedResult",
      "type": "object"
    },
    "AssignmentRequest": {
      "additionalProperties": false,
      "properties": {
        "doctorId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Doctorid",
          "type": "string"
        },
        "expectedCaseVersion": {
          "minimum": 1,
          "title": "Expectedcaseversion",
          "type": "integer"
        },
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "required": [
        "doctorId",
        "expectedCaseVersion"
      ],
      "title": "AssignmentRequest",
      "type": "object"
    },
    "CasePage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/CaseSummary"
          },
          "title": "Items",
          "type": "array"
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nextcursor"
        },
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "required": [
        "items"
