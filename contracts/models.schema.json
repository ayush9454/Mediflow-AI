        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "caseId",
        "reportId",
        "patientId",
        "processingStatus",
        "reviewStatus",
        "version",
        "reviewVersion",
        "createdAt"
      ],
      "title": "CaseSummary",
      "type": "object"
    },
    "CompletionRequest": {
      "additionalProperties": false,
      "description": "Patient identity and storage paths are never client input.",
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "title": "CompletionRequest",
      "type": "object"
    },
    "DoctorPage": {
      "additionalProperties": false,
