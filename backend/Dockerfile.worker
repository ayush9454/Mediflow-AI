FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.13.4 /uv /bin/uv
WORKDIR /service
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/service/.venv/bin:$PATH" OMP_THREAD_LIMIT=1 OMP_NUM_THREADS=1
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng \
    && mkdir -p /service/licenses \
    && cp -a /usr/share/doc /service/licenses/debian-packages \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --locked --no-dev --no-editable --extra processing \
    && mkdir -p /service/licenses/python-distributions \
    && find /service/.venv/lib -type d -name '*.dist-info' -exec cp -a '{}' /service/licenses/python-distributions/ \;
RUN useradd --create-home --uid 10001 mediflow
USER mediflow
# The durable worker never substitutes test analysis for the ticket-08 provider.
CMD ["python", "-m", "mediflow.worker"]
