# Configuration names only. Copy to .env locally; never commit actual secrets.
MEDIFLOW_ENV=development
MEDIFLOW_FIREBASE_PROJECT_ID=
# Auth checks Firebase signature/revocation plus server user/hospital records.
# Production rejects Firebase emulator host variables.
# The Android FIREBASE_API_KEY is public project configuration, not an Admin credential.
MEDIFLOW_AZURE_STORAGE_ACCOUNT_URL=
MEDIFLOW_AZURE_DOCUMENT_CONTAINER=reports
MEDIFLOW_AZURE_QUEUE_NAME=report-processing
MEDIFLOW_JOB_TIMEOUT_SECONDS=270
MEDIFLOW_GEMINI_MODEL=
# Set true only after confirming the selected project's free tier and disabled billing.
MEDIFLOW_GEMINI_FREE_TIER_CONFIRMED=false
# GOOGLE_APPLICATION_CREDENTIALS=/private/path/to/service-account.json
# GEMINI_API_KEY=
# Prefer Azure managed identity for hosted storage access.
